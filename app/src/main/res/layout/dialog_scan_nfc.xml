<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/surface_round_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Dialog -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btnDialogClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="#1E1B4B"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDialogManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="#EEF2FF"
                android:text="Enter Manually"
                android:textColor="#6366F1"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Position your card inside the frame"
            android:textColor="#1E293B"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <!-- Card Scanning Viewport Frame (Screen 3 Reference) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dialogScannerCard"
            android:layout_width="match_parent"
            android:layout_height="175dp"
            app:cardBackgroundColor="#041B37"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#40F59E0B">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <!-- EMV Gold Chip & Contactless Waves -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="32dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_chip_emv_gold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:rotation="90"
                        android:text=")))"
                        android:textColor="#F8FAFC"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Bank Branding Top Right -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDialogBankName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MANDIRI"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/tvDialogBankBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="#F59E0B"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="e-money"
                        android:textColor="#041B37"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Footer: Cardholder & Number -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SARAH SMITH"
                        android:textColor="#CBD5E1"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="6032 •••• •••• 8192"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />
                </LinearLayout>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Scanning status & progress -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:text="Scanning ..."
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_width="140dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:indeterminate="true"
            app:indicatorColor="#F59E0B"
            app:trackColor="#E2E8F0"
            app:trackCornerRadius="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Tempelkan kartu Mandiri, Flazz, TapCash, atau Brizzi ke belakang HP"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <!-- Demo Simulation Tap Options in Dialog (Semua Kartu Bank) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:text="UJI COBA PROFIL KARTU BANK:"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimulateMandiri"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:padding="0dp"
                android:text="Mandiri"
                android:textAllCaps="false"
                android:textSize="11sp"
                app:cornerRadius="10dp"
                app:strokeColor="#CBD5E1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimulateFlazz"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:padding="0dp"
                android:text="Flazz"
                android:textAllCaps="false"
                android:textSize="11sp"
                app:cornerRadius="10dp"
                app:strokeColor="#CBD5E1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimulateTapCash"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:padding="0dp"
                android:text="TapCash"
                android:textAllCaps="false"
                android:textSize="11sp"
                app:cornerRadius="10dp"
                app:strokeColor="#CBD5E1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimulateBrizzi"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:padding="0dp"
                android:text="Brizzi"
                android:textAllCaps="false"
                android:textSize="11sp"
                app:cornerRadius="10dp"
                app:strokeColor="#CBD5E1" />
        </LinearLayout>

        <!-- Footer Attribution Pribadi -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:textStyle="italic"
            android:textSize="8pt"
            android:textColor="#94A3B8"
            android:text="Dibuat dan digunakan secara pribadi oleh Erwin Dwi K" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
